# Copy this file to .env.local and fill in real values.
# .env.local is already excluded by .gitignore — never commit real secrets.

# Server-side only. Never referenced from any "use client" file or exposed
# to the browser. Read exclusively by lib/gemini/client.ts.
GEMINI_API_KEY=your-server-side-only-key

# A Gemini model confirmed working on the free tier for this key via a live
# ListModels + generateContent check (2026-09-18). Re-confirm before
# deploying if this project sits unused for a while — free-tier eligibility
# and model retirement both change over time (see
# specs/001-company-homepage/research.md).
GEMINI_MODEL=gemini-3.5-flash-lite
